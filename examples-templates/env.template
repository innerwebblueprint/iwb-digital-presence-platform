# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                    IWB Digital Presence Platform                          ║
# ║                          Environment Configuration                        ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# Instructions:
# 1. Copy this file to .env: cp examples-templates/.env-template .env
# 2. Fill in the REQUIRED fields below (marked with ⚠️)
# 3. Optionally customize the OPTIONAL fields
# 4. Leave AUTO-GENERATED fields empty (unique secure passwords created on every deployment)
#
# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED USER INPUT ⚠️
# ═══════════════════════════════════════════════════════════════════════════

# Project Name (3-letter code) - Used for container naming and database prefixes
# Examples: IWB (InnerWebBlueprint.com), SMA (SharperMindAcademy.com)
COMPOSE_PROJECT_NAME=abc

# Your Domain - Where your platform will be accessible
# Example: example.com (will receive email at user@example.com)
IWB_DOMAIN=yourdomain.tld

# Public IP Address
# Uncomment and set to a specific public facing IP
#PUBLIC_IP=x.x.x.x

# Primary Email Account - Main mailbox for your domain
# This will be the first email user created (e.g., postmaster@yourdomain.tld)
IWB_MAIL_USER=postmaster
IWB_MAIL_PASS=changeme123         # ⚠️ CHANGE THIS to a strong password!

# Persistent Cloud Storage - For backups and persistent data

# Storage provider - Options: storj or r2
IWB_PERSISTENT_STORAGE=storj

# Learn about getting your access grant from: https://InnerWebBlueprint.com/tutorials/storj-setup
IWB_STORJ_GRANT=                  # ⚠️ Paste your Storj access grant here
IWB_STORJ_MEDIA_KEY=              # ⚠️ Media library access key

# Cloudflare R2 Credentials (required when IWB_PERSISTENT_STORAGE=r2)
# R2 endpoint format: https://<account-id>.r2.cloudflarestorage.com
IWB_R2_ACCOUNT_ID=
IWB_R2_ACCESS_KEY_ID=
IWB_R2_SECRET_ACCESS_KEY=
IWB_R2_BUCKET="${COMPOSE_PROJECT_NAME}wpops"
IWB_R2_REGION=auto

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Operating Mode
# Options: 'full' (recommended) or 'bare-bones-email-only'
# - full: Complete platform with WordPress, n8n, email, and all features
# - bare-bones-email-only: Basic receive Email services only (minimal footprint)
IWB_MODE=full

# n8n Automation Platform - Initial admin credentials
# Note: I don't think this is actually working. Configure these on first login via n8n web interface
IWB_N8N_USER=admin
IWB_N8N_PASSWORD=changeme123      # ⚠️ CHANGE THIS on first login!
IWB_N8N_USER_MANAGEMENT=false

# Storj Buckets - Customize if needed (defaults are fine)
IWB_STORJ_WPOPS_BUCKET="${COMPOSE_PROJECT_NAME}wpops"
IWB_STORJ_MEDIA_BUCKET="${COMPOSE_PROJECT_NAME}media"


# ═══════════════════════════════════════════════════════════════════════════
# AUTO-GENERATED (Leave Empty - Secure Passwords Created Automatically)
# ═══════════════════════════════════════════════════════════════════════════
#
# These passwords are automatically generated on first startup and persisted
# to /var/data/state/ for consistency across container restarts.
# They will be regenerated for new volumes (new deployments).
#

# MySQL Root Password - Auto-generated secure password on first startup
IWB_MYSQL_ROOT_PASSWORD=

# PostfixAdmin Database - Auto-generated credentials
IWB_MYSQL_PA_DATABASE=postfix
IWB_MYSQL_PA_USER=postfix
IWB_POSTFIXADMIN_SQL_PASSWORD=    # Auto-generated on first startup

# WordPress Database - Auto-generated credentials
IWB_WP_MYSQL_DATABASE="${COMPOSE_PROJECT_NAME}wpdb"
IWB_WP_MYSQL_USER="${COMPOSE_PROJECT_NAME}wpdb"
IWB_WP_MYSQL_PASSWORD=            # Auto-generated on first startup
IWB_WP_SITEURL="https://${IWB_DOMAIN}"
IWB_WP_HOME="${IWB_WP_SITEURL}"

# Rspamd Anti-Spam - Auto-generated web UI passwords
# Access web UI at: https://yourdomain.tld/rspamd
IWB_RSPAMD_CONTROLLER_PASSWORD=          # Auto-generated (normal access)
IWB_RSPAMD_CONTROLLER_ENABLE_PASSWORD=   # Auto-generated (enable/disable modules)


# ═══════════════════════════════════════════════════════════════════════════
# SYSTEM CONFIGURATION (Do Not Modify)
# ═══════════════════════════════════════════════════════════════════════════


# Advanced settings (auto-configured by setup-env.sh):
# - IWB_WP_MYSQL_HOST=localhost
# - IWB_WP_TABLE_PREFIX=wp_
# - Database connection strings
# - Internal service URLs