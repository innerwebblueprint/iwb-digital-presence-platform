# ===============================
# IWB Digital Presence .env File
# ===============================

# COMPOSE_PROJECT_NAME is mostly cosmentic - it just sets names of docker services
# Set this to a 3 letter representation of your project 
# For example, IWB (for InnerWebBlueprint.com)
# Or SMA (for SharperMindAcademy.com)
COMPOSE_PROJECT_NAME=abc

# ======================
# Some base Configuration
# ======================
# IWB_MODE, options: 'bare-bones-email-only' or 'full'
# bare-bones-email-only mode sets up a bare bones email enviornmnet.
# full mode is a fully configured email and wordpress enviornment.
IWB_MODE=full
                        
# ======================
# Domain Configuration
# ======================
IWB_DOMAIN=yourdomain.tld         # Domain for accepting email i.e. email@yourdomain.tld

# =====================
# Server Configuration
# =====================
#PUBLIC_IP=x.x.x.x                # External Public IP to bind services

# ====================
# Database Admin Setup
# ====================
IWB_MYSQL_ROOT_PASSWORD=optional      # This is optional, a secure password will be auto-generated on startup

# ====================
# Mail Admin Setup
# ====================
IWB_MAIL_USER=postmaster          # Default user account for mail (postmaster)
IWB_MAIL_PASS=changeme123         # Make sure to use a strong password!
IWB_MYSQL_PA_DATABASE=postfix
IWB_MYSQL_PA_USER=postfix
IWB_MYSQL_PA_PASSWORD=optional    # This is optional, a secure password will be auto-generated on startup


# =========================
# WordPress
# =========================
IWB_MYSQL_WP_DATABASE="${COMPOSE_PROJECT_NAME}wpdb"
IWB_MYSQL_WP_USER=iwbuser
IWB_MYSQL_WP_PASSWORD=iwbpass

# =============================
# Offsite Object Storage (S3)
# =============================
# Persistent File / Object Storage
IWB_PERSISTENT_STORAGE=storj # options: storj, possible new options in the future
IWB_STORJ_GRANT=
IWB_STORJ_WPOPS_BUCKET=
