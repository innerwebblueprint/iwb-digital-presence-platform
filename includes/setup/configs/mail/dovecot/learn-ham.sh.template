#!/bin/sh

RSPAMC_BIN="$(command -v rspamc 2>/dev/null || true)"

if [ -z "$RSPAMC_BIN" ]; then
  for candidate in /usr/bin/rspamc /usr/local/bin/rspamc /usr/sbin/rspamc /bin/rspamc; do
    if [ -x "$candidate" ]; then
      RSPAMC_BIN="$candidate"
      break
    fi
  done
fi

if [ -z "$RSPAMC_BIN" ]; then
  echo "rspamc not found" >&2
  exit 127
fi

if command -v logger >/dev/null 2>&1; then
  logger -t iwb-imapsieve "starting rspamc learn_ham"
fi

"$RSPAMC_BIN" -h 127.0.0.1:11334 -P '{{IWB_RSPAMD_CONTROLLER_PASSWORD}}' learn_ham
status=$?

if command -v logger >/dev/null 2>&1; then
  logger -t iwb-imapsieve "finished rspamc learn_ham with exit code $status"
fi

exit "$status"
