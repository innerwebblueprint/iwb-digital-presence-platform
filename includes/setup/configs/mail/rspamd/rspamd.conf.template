# includes/setup/configs/mail/rspamd/rspamd.conf.template

# This is a rendered file for domain {{IWB_DOMAIN}}
# Please do not edit here, this template is built into the docker container

# Main Rspamd configuration file

# Global options
options {
    pidfile = "/run/rspamd/rspamd.pid";
    tempdir = "/tmp";
    log_level = "info";
}

# === Worker Definitions ===

worker "controller" {
    bind_socket = "127.0.0.1:11334";
}

worker "proxy" {
    bind_socket = "127.0.0.1:11332";
}

# Normal scanning worker (this one is default, but we’ll define it explicitly)
worker "normal" {
    bind_socket = "127.0.0.1:11333";
}

# === Modular Overrides ===
include "/etc/rspamd/local.d/worker-proxy.inc";
include "/etc/rspamd/local.d/worker-controller.inc";
include "/etc/rspamd/modules.conf";  # enables DKIM, SPF, etc
include "/etc/rspamd/local.d/logging.inc";
