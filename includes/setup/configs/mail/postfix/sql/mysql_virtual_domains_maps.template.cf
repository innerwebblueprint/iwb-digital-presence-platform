# includes/setup/configs/mail/postfix/sql/mysql_virtual_domains_maps.template.cf
# /etc/postfix/sql/

user = {{IWB_POSTFIXADMIN_SQL_USER}}
password = {{IWB_POSTFIXADMIN_SQL_PASSWORD}}
hosts = 127.0.0.1
dbname = {{IWB_POSTFIXADMIN_SQL_DBNAME}}
query = SELECT domain FROM domain WHERE domain='%s' AND active = '1'
